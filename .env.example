# Copia este archivo como .env (el .env no se sube al repositorio).
# Coincide con el Postgres local de docker-compose.yml. En producción usa credenciales propias.
DATABASE_URL="postgresql://pos:pos_local@localhost:5433/riovivo_pos?schema=public"

# Firma de la cookie de sesión. En producción: una cadena larga y aleatoria (obligatoria).
SESSION_SECRET="cambia-esta-cadena-por-una-larga-y-aleatoria"

PORT=3100

# Voces del POS con ElevenLabs (solo en tu computador; se usan al correr `npm run voces`).
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
# Opcional: cuántas mesas numeradas grabar (por defecto 20) y nombres extra separados por coma.
# VOZ_MESAS=20
# VOZ_NOMBRES="Cabaña 1,Cabaña 2,Terraza"
