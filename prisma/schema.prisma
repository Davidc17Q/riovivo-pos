generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  VENDEDOR
  // Pantalla de comandas de cocina y bar: no ve ventas, caja ni dinero.
  COCINA
}

// A dónde va el pedido de un producto al venderlo o cargarlo a una cuenta.
enum Estacion {
  NINGUNA
  COCINA
  BAR
}

enum EstadoComanda {
  PENDIENTE
  PREPARANDO
  LISTA
  ENTREGADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  // Varios métodos en una misma venta: el reparto está en VentaPago.
  MIXTO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  ANULACION
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum EstadoCuenta {
  ABIERTA
  COBRADA
  CANCELADA
}

enum EstadoVenta {
  ACTIVA
  ANULADA
}

model Usuario {
  id             Int                    @id @default(autoincrement())
  usuario        String                 @unique
  nombre         String
  claveHash      String
  rol            Rol                    @default(VENDEDOR)
  activo         Boolean                @default(true)
  creadoEn       DateTime               @default(now()) @db.Timestamptz(3)
  ventas         Venta[]                @relation("VentaVendedor")
  ventasAnuladas Venta[]                @relation("VentaAnuladaPor")
  cajas          SesionCaja[]           @relation("CajaAbiertaPor")
  cajasCerradas  SesionCaja[]           @relation("CajaCerradaPor")
  movimientos    MovimientoInventario[]
  cuentas        Cuenta[]
  comandas       Comanda[]
}

// Turno de caja de un usuario. Al cerrar se guarda el cuadre tal como se contó;
// esos valores no se reescriben después.
model SesionCaja {
  id                  Int        @id @default(autoincrement())
  usuarioId           Int
  usuario             Usuario    @relation("CajaAbiertaPor", fields: [usuarioId], references: [id])
  estado              EstadoCaja @default(ABIERTA)
  baseInicial         Int
  abiertaEn           DateTime   @default(now()) @db.Timestamptz(3)
  cerradaEn           DateTime?  @db.Timestamptz(3)
  cerradaPorId        Int?
  cerradaPor          Usuario?   @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id])
  ventasEfectivo      Int?
  ventasTarjeta       Int?
  ventasTransferencia Int?
  efectivoEsperado    Int?
  efectivoContado     Int?
  // contado − esperado: positivo sobra, negativo falta.
  diferencia          Int?
  nota                String?
  ventas              Venta[]

  @@index([usuarioId, estado])
}

// Todo el dinero va en pesos enteros (COP), nunca decimales.
model Producto {
  id            Int                    @id @default(autoincrement())
  nombre        String
  categoria     String
  precio        Int
  activo        Boolean                @default(true)
  // false = insumo interno: se lleva en inventario pero no aparece en caja.
  seVende       Boolean                @default(true)
  controlaStock Boolean                @default(false)
  stock         Int                    @default(0)
  estacion      Estacion               @default(NINGUNA)
  creadoEn      DateTime               @default(now()) @db.Timestamptz(3)
  items         VentaItem[]
  movimientos   MovimientoInventario[]
  enCuentas     CuentaItem[]
}

model Venta {
  id              Int                    @id @default(autoincrement())
  creadaEn        DateTime               @default(now()) @db.Timestamptz(3)
  usuarioId       Int
  usuario         Usuario                @relation("VentaVendedor", fields: [usuarioId], references: [id])
  subtotal        Int
  descuento       Int                    @default(0)
  total           Int
  metodoPago      MetodoPago
  pagos           VentaPago[]
  // Cliente, mesa, cabaña o habitación (opcional, texto libre).
  referencia      String?
  // Efectivo que entregó el cliente y lo que se le devolvió (solo si pagó en efectivo).
  recibido        Int?
  cambio          Int?
  items           VentaItem[]
  movimientos     MovimientoInventario[]
  // Nula solo en ventas anteriores a que existiera la caja.
  cajaId          Int?
  caja            SesionCaja?            @relation(fields: [cajaId], references: [id])
  // Una venta nunca se borra: se anula y deja de contar en caja y reportes.
  estado          EstadoVenta            @default(ACTIVA)
  anuladaEn       DateTime?              @db.Timestamptz(3)
  anuladaPorId    Int?
  anuladaPor      Usuario?               @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id])
  motivoAnulacion String?
  cuenta          Cuenta?
  comandas        Comanda[]

  @@index([creadaEn])
  @@index([cajaId])
}

// Cuánto se pagó con cada método. Suma exactamente el total de la venta.
// La caja y los reportes cuadran por método a partir de aquí.
model VentaPago {
  id      Int        @id @default(autoincrement())
  ventaId Int
  venta   Venta      @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  metodo  MetodoPago
  monto   Int

  @@index([ventaId])
}

// Nombre y precio se copian al vender: el ticket no cambia si luego se edita el producto.
model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  nombre         String
  precioUnitario Int
  cantidad       Int
  totalLinea     Int

  @@index([ventaId])
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo            TipoMovimiento
  // Cambio con signo: positivo entra, negativo sale.
  cantidad        Int
  stockResultante Int
  nota            String?
  usuarioId       Int
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  ventaId         Int?
  venta           Venta?         @relation(fields: [ventaId], references: [id])
  creadoEn        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([productoId, creadoEn])
}

// Cuenta abierta de una cabaña, mesa o cliente: se le van cargando consumos durante
// el día y se cobra una sola vez. Al cobrarla se crea una venta normal (caja, pagos,
// inventario y reportes salen de ahí).
model Cuenta {
  id           Int          @id @default(autoincrement())
  nombre       String
  estado       EstadoCuenta @default(ABIERTA)
  abiertaEn    DateTime     @default(now()) @db.Timestamptz(3)
  abiertaPorId Int
  abiertaPor   Usuario      @relation(fields: [abiertaPorId], references: [id])
  cerradaEn    DateTime?    @db.Timestamptz(3)
  ventaId      Int?         @unique
  venta        Venta?       @relation(fields: [ventaId], references: [id])
  items        CuentaItem[]
  comandas     Comanda[]

  @@index([estado])
}

// El precio no se guarda: se cobra al precio vigente al momento de cobrar.
model CuentaItem {
  id         Int      @id @default(autoincrement())
  cuentaId   Int
  cuenta     Cuenta   @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
  cantidad   Int

  @@unique([cuentaId, productoId])
}

// Ajustes del negocio editables por el administrador (clave → valor de texto).
model Ajuste {
  clave         String   @id
  valor         String
  actualizadoEn DateTime @updatedAt @db.Timestamptz(3)
}

// Pedido para cocina o bar: nace al vender o al cargar a una cuenta productos con estación.
// Una venta con comida y bebida genera dos comandas, una por estación.
model Comanda {
  id            Int           @id @default(autoincrement())
  creadaEn      DateTime      @default(now()) @db.Timestamptz(3)
  actualizadaEn DateTime      @updatedAt @db.Timestamptz(3)
  estacion      Estacion
  estado        EstadoComanda @default(PENDIENTE)
  referencia    String?
  ventaId       Int?
  venta         Venta?        @relation(fields: [ventaId], references: [id])
  cuentaId      Int?
  cuenta        Cuenta?       @relation(fields: [cuentaId], references: [id])
  usuarioId     Int
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  items         ComandaItem[]

  @@index([estado, estacion])
}

model ComandaItem {
  id        Int     @id @default(autoincrement())
  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  nombre    String
  cantidad  Int
}
