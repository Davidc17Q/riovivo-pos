generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  VENDEDOR
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  VENTA
  ANULACION
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum EstadoVenta {
  ACTIVA
  ANULADA
}

model Usuario {
  id             Int                    @id @default(autoincrement())
  usuario        String                 @unique
  nombre         String
  claveHash      String
  rol            Rol                    @default(VENDEDOR)
  activo         Boolean                @default(true)
  creadoEn       DateTime               @default(now()) @db.Timestamptz(3)
  ventas         Venta[]                @relation("VentaVendedor")
  ventasAnuladas Venta[]                @relation("VentaAnuladaPor")
  cajas          SesionCaja[]           @relation("CajaAbiertaPor")
  cajasCerradas  SesionCaja[]           @relation("CajaCerradaPor")
  movimientos    MovimientoInventario[]
}

// Turno de caja de un usuario. Al cerrar se guarda el cuadre tal como se contó;
// esos valores no se reescriben después.
model SesionCaja {
  id                  Int        @id @default(autoincrement())
  usuarioId           Int
  usuario             Usuario    @relation("CajaAbiertaPor", fields: [usuarioId], references: [id])
  estado              EstadoCaja @default(ABIERTA)
  baseInicial         Int
  abiertaEn           DateTime   @default(now()) @db.Timestamptz(3)
  cerradaEn           DateTime?  @db.Timestamptz(3)
  cerradaPorId        Int?
  cerradaPor          Usuario?   @relation("CajaCerradaPor", fields: [cerradaPorId], references: [id])
  ventasEfectivo      Int?
  ventasTarjeta       Int?
  ventasTransferencia Int?
  efectivoEsperado    Int?
  efectivoContado     Int?
  // contado − esperado: positivo sobra, negativo falta.
  diferencia          Int?
  nota                String?
  ventas              Venta[]

  @@index([usuarioId, estado])
}

// Todo el dinero va en pesos enteros (COP), nunca decimales.
model Producto {
  id            Int                    @id @default(autoincrement())
  nombre        String
  categoria     String
  precio        Int
  activo        Boolean                @default(true)
  // false = insumo interno: se lleva en inventario pero no aparece en caja.
  seVende       Boolean                @default(true)
  controlaStock Boolean                @default(false)
  stock         Int                    @default(0)
  creadoEn      DateTime               @default(now()) @db.Timestamptz(3)
  items         VentaItem[]
  movimientos   MovimientoInventario[]
}

model Venta {
  id              Int                    @id @default(autoincrement())
  creadaEn        DateTime               @default(now()) @db.Timestamptz(3)
  usuarioId       Int
  usuario         Usuario                @relation("VentaVendedor", fields: [usuarioId], references: [id])
  subtotal        Int
  descuento       Int                    @default(0)
  total           Int
  metodoPago      MetodoPago
  items           VentaItem[]
  movimientos     MovimientoInventario[]
  // Nula solo en ventas anteriores a que existiera la caja.
  cajaId          Int?
  caja            SesionCaja?            @relation(fields: [cajaId], references: [id])
  // Una venta nunca se borra: se anula y deja de contar en caja y reportes.
  estado          EstadoVenta            @default(ACTIVA)
  anuladaEn       DateTime?              @db.Timestamptz(3)
  anuladaPorId    Int?
  anuladaPor      Usuario?               @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id])
  motivoAnulacion String?

  @@index([creadaEn])
  @@index([cajaId])
}

// Nombre y precio se copian al vender: el ticket no cambia si luego se edita el producto.
model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
  nombre         String
  precioUnitario Int
  cantidad       Int
  totalLinea     Int

  @@index([ventaId])
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tipo            TipoMovimiento
  // Cambio con signo: positivo entra, negativo sale.
  cantidad        Int
  stockResultante Int
  nota            String?
  usuarioId       Int
  usuario         Usuario        @relation(fields: [usuarioId], references: [id])
  ventaId         Int?
  venta           Venta?         @relation(fields: [ventaId], references: [id])
  creadoEn        DateTime       @default(now()) @db.Timestamptz(3)

  @@index([productoId, creadoEn])
}
